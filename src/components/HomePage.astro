---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGrid from './ProjectGrid.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { getProjects, getArticles } from '../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
// Главная показывает все проекты и статьи, плашка в шапке фильтрует их на месте
const [projects, articles] = await Promise.all([getProjects(lang), getArticles(lang)]);
---

<BaseLayout>
  <h1 class="visually-hidden">{t('site.title')}</h1>
  <div class="ids__space L"></div>
  <section class="project-grid-wrap" aria-label={t('projects.heading')}>
    <ProjectGrid lang={lang} id="projects" projects={projects} articles={articles} />
  </section>
  <div class="ids__space XL"></div>
</BaseLayout>
