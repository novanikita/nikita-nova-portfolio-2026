---
import ProjectCard from './ProjectCard.astro';
import ArticleCard from './ArticleCard.astro';
import { placeholderProjects } from '../data/projects.placeholder';
import type { Lang } from '../i18n/ui';
import type { LocalizedProject, LocalizedArticle } from '../lib/content';
import { useTranslations, localePath } from '../i18n/utils';

interface Props {
  lang: Lang;
  id: string;
  projects: LocalizedProject[];
  /** Статьи в той же сетке, после проектов */
  articles?: LocalizedArticle[];
}

const { lang, id, projects, articles = [] } = Astro.props;
const t = useTranslations(lang);
---

<div class="ids__sequence L gap-S project-grid" id={id}>
  {projects.map((p) => <ProjectCard project={p} />)}
  {articles.map((a) => <ArticleCard article={a} />)}
  {
    /* Пока настоящих проектов нет — заглушки, чтобы было видно сетку и фильтр */
    projects.length === 0 &&
      placeholderProjects.map((p) => (
        <a class="ids__sequence-item project-card" href={localePath(lang, 'projects')} data-category={p.category}>
          <div class="project-card__cover" aria-hidden="true">
            {p.number}
          </div>
          <div class="project-card__caption">
            <h3 class="project-card__title">
              {t('projects.placeholder')} {p.number}
            </h3>
          </div>
        </a>
      ))
  }
</div>
