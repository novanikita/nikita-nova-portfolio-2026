---
import { Image } from 'astro:assets';
import type { LocalizedProject } from '../lib/content';
import { coverTone } from '../lib/cover-tone';
import { COVER_WIDTHS, coverSizes } from '../lib/cover-sizes';

interface Props {
  project: LocalizedProject;
}

const { project } = Astro.props;
const { entry } = project;
const { card } = entry.data;
const tone = await coverTone(entry.data.cover);
---

<a
  class:list={['project-card', { M: card === 'M', 'is-dark': tone.dark }]}
  href={project.url}
  data-category={entry.data.category}
  style={`--tone: ${tone.color}`}
>
  <div class="project-card__cover">
    <Image
      src={entry.data.cover}
      alt={project.coverAlt}
      widths={COVER_WIDTHS}
      sizes={coverSizes(entry.data.cover, card)}
      format="avif"
      loading="lazy"
    />
  </div>
  <div class="project-card__caption">
    <h3 class="project-card__title">{project.title}</h3>
  </div>
</a>
