---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { getProjects, getArticles } from '../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const gridId = 'projects';
const [projects, articles] = await Promise.all([getProjects(lang), getArticles(lang)]);
---

<BaseLayout title={`${t('projects.heading')} — ${t('site.name')}`}>
  <div class="ids__wrapper L">
    <div class="ids__space L"></div>
    <h1 class="S">{t('projects.heading')}</h1>
    <div class="ids__space L"></div>
  </div>
  <div class="project-grid-wrap">
    <ProjectGrid lang={lang} id={gridId} projects={projects} articles={articles} />
  </div>
  <div class="ids__space XL"></div>
</BaseLayout>
