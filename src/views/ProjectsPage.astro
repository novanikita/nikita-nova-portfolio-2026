---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectFilter from '../components/ProjectFilter.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { getProjects } from '../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const gridId = 'projects';
const projects = await getProjects(lang);
---

<BaseLayout title={`${t('projects.heading')} — ${t('site.name')}`}>
  <div class="ids__wrapper L">
    <div class="ids__space L"></div>
    <h1 class="S">{t('projects.heading')}</h1>
    <div class="ids__space S"></div>
    <ProjectFilter lang={lang} controls={gridId} />
    <div class="ids__space L"></div>
    <ProjectGrid lang={lang} id={gridId} projects={projects} />
    <div class="ids__space XL"></div>
  </div>
</BaseLayout>
