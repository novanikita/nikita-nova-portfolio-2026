---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { categoryLabel } from '../data/categories';
import { localizeProjectEntry, projectTextBlocks, textExcerpt } from '../lib/content';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'projects'>;
}

const { lang, entry } = Astro.props;
const t = useTranslations(lang);
const project = await localizeProjectEntry(entry, lang);
const { data } = entry;

const meta = [
  { label: t('project.client'), value: project.client },
  { label: t('project.year'), value: data.date.slice(0, 4) },
  { label: t('project.category'), value: categoryLabel(data.category, lang) },
].filter((m) => m.value);

const [intro = '', ...textBlocks] = projectTextBlocks(project);
const textSlots = data.gallery.filter((item) => 'text' in item).length;
if (textSlots !== textBlocks.length) {
  throw new Error(`${entry.id}, ${lang}: мест для текста в галерее ${textSlots}, блоков текста ${textBlocks.length}`);
}

// Галерея, разрезанная вставками текста: картинки, текст, картинки
type Figure = Exclude<(typeof data.gallery)[number], { text: true }>;
const parts: { figures: Figure[]; text?: string }[] = [{ figures: [] }];
let nextText = 0;
for (const item of data.gallery) {
  if ('text' in item) {
    parts.at(-1)!.text = textBlocks[nextText++];
    parts.push({ figures: [] });
  } else {
    parts.at(-1)!.figures.push(item);
  }
}
---

<BaseLayout
  title={`${project.title} — ${t('site.name')}`}
  description={project.description ?? textExcerpt(intro)}
  ogImage={data.cover}
  current={data.category}
>
  <article>
    <div class="ids__wrapper S">
      <dl class="project-meta">
        {
          meta.map((m) => (
            <div>
              <dt>{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))
        }
      </dl>
      <div class="ids__space M"></div>
      <h1 class="project-title">{project.title}</h1>
      <div class="ids__space M"></div>
      <div class="project-text" set:html={intro} />
      <div class="ids__space L"></div>
    </div>
    {
      parts.map((part, i) => (
        <>
          {part.figures.length > 0 && (
            <div class="ids__wrapper XL">
              <Gallery figures={part.figures} first={i === 0} />
            </div>
          )}
          {part.text && (
            <div class="ids__wrapper S">
              <div class="project-text" set:html={part.text} />
              <div class="ids__space L" />
            </div>
          )}
        </>
      ))
    }
    <div class="ids__space XL"></div>
  </article>
</BaseLayout>
