---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations, localePath } from '../i18n/utils';
import { categoryLabel } from '../data/categories';
import { localizeProjectEntry, getNextProject, renderLocalized } from '../lib/content';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'projects'>;
}

const { lang, entry } = Astro.props;
const t = useTranslations(lang);
const project = await localizeProjectEntry(entry, lang);
const next = await getNextProject(entry, lang);
const { Content } = await renderLocalized(project);
const { data } = entry;

const meta = [
  { label: t('project.client'), value: project.client },
  { label: t('project.scope'), value: project.scope },
  { label: t('project.year'), value: String(data.year) },
  { label: t('project.category'), value: categoryLabel(data.category, lang) },
].filter((m) => m.value);
---

<BaseLayout title={`${project.title} — ${t('site.name')}`} description={project.description} ogImage={data.cover} current={data.category}>
  <article class="ids__wrapper L">
    <div class="ids__space L"></div>
    <p><a class="project-back" href={localePath(lang)}>← {t('nav.allProjects')}</a></p>
    <div class="ids__space S"></div>
    <h1 class="S">{project.title}</h1>
    <dl class="project-meta">
      {
        meta.map((m) => (
          <div>
            <dt>{m.label}</dt>
            <dd>{m.value}</dd>
          </div>
        ))
      }
      {
        data.link && (
          <div>
            <dd>
              <a href={data.link} target="_blank" rel="noopener">
                {t('project.link')} ↗
              </a>
            </dd>
          </div>
        )
      }
    </dl>
    <div class="ids__space M"></div>
    <div class="ids__text-width project-text">
      <Content />
    </div>
    <div class="ids__space L"></div>
    {data.galleries.map((figures, i) => <Gallery figures={figures} first={i === 0} />)}
    {
      next && (
        <>
          <div class="ids__space L"></div>
          <a class="project-next" href={next.url}>
            <p>{t('project.next')}</p>
            <h2 class="XS">{next.title}</h2>
          </a>
        </>
      )
    }
    <div class="ids__space XL"></div>
  </article>
</BaseLayout>
